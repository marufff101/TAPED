# Copy this file to .env and edit it.

PORT=3000

# The host (admin). Only this email gets host powers, and nobody can sign up with it.
HOST_EMAIL=marufff08697@gmail.com
HOST_NAME=Maruf

# Password for the host account, used the first time the server starts.
# Leave it empty and a random password is printed in the terminal instead.
HOST_PASSWORD=

# Secret used to sign login cookies. Leave empty in development and one is created for you.
# In production, set a long random value (for example: openssl rand -hex 32).
JWT_SECRET=

# Where the SQLite database lives. Defaults to ./data
# DATA_DIR=./data

# Turn these on when the site runs over https behind a proxy.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Email, used to send the 6-digit verification codes.
# Leave SMTP_HOST empty while developing: codes are then printed in the terminal.
# Gmail example: turn on 2-step verification, create an "App password" at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=Taped <yourname@gmail.com>
